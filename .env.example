# Environment variables for the backend
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to Git.

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/academic_assessment_db

# JWT configuration
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-very-strong-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application settings
APP_NAME=AI Academic Assessment System
APP_VERSION=1.0.0
DEBUG=false

# Document Processing & RAG (Phase 3)
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_PROVIDER=default
EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_API_KEY=
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=4
